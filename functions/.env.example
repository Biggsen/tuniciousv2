# Copy to functions/.env before deploy. Gitignored. 2nd gen functions read these at deploy time.
YOUTUBE_API_KEY=
# Sent as the YouTube request Referer. Required when the key is HTTP-referrer restricted.
# The current key allows http://localhost:4827/ only.
YOUTUBE_API_REFERER=http://localhost:4827/
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
MUSICBRAINZ_DEFAULT_USER_AGENT=Tunicious/2.0 (your@email.com)
